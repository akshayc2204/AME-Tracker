{
  "name": "ame-tracker-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AME Tracker desktop window. Starts the API and closes it when the window closes.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.cjs",
    "package:win": "node scripts/package-win.cjs"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ame.tracker",
    "productName": "AME Tracker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging/backend",
        "to": "backend"
      },
      {
        "from": "staging/portal",
        "to": "portal"
      },
      {
        "from": "staging/node",
        "to": "node"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AME Tracker",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
