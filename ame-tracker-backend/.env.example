# SQLite (local/dev). For PostgreSQL later:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ame_tracker?schema=public
DATABASE_URL=file:./dev.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Local file storage (S3-compatible vars reserved for later)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=

# Upload limits
MAX_UPLOAD_MB=25

# Folder auto-sync (pair .t4vjob + Item Schedule .xlsx)
# Default path/interval; System Admin can override these from the Admin profile page.
DATA_UPLOADS_PATH=/Users/mangeshkharat/DataUploads
FOLDER_SYNC_INTERVAL_MS=300000
FOLDER_SYNC_ENABLED=true

# Trimble FabShop SQL Server (optional — read-only sync)
FABSHOP_DB_SERVER=127.0.0.1
FABSHOP_DB_PORT=1433
FABSHOP_DB_DATABASE=TrimbleFabShop (US Metric)
FABSHOP_DB_USER=ame_readonly
FABSHOP_DB_PASSWORD=change-me
FABSHOP_DB_ENCRYPT=false
