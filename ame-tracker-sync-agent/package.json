{
  "name": "ame-tracker-sync-agent",
  "version": "1.0.0",
  "private": true,
  "author": "AME Tracker",
  "description": "Desktop sync agent — watches a local folder and uploads .t4vjob + .xlsx pairs to AME Tracker",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir"
  },

  "build": {
    "appId": "com.ame.tracker.syncagent",
    "productName": "AME Tracker Sync Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "form-data": "^4.0.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
